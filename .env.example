# Copy to .env.local for local development (values from `supabase start` output
# or `supabase status`). For deploying to Vercel, see docs/deployment.md for
# exactly which of these go into which Vercel environment (Production /
# Preview / Development) and where the values come from.

# Public — safe to expose to the browser. Required in every environment
# (Production, Preview, Development) that serves the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only, grants full bypass-RLS access. Only ever used by
# scripts/seed-auth-user.ts to create the shared admin login against a local
# or CI Supabase instance. Never set this in Vercel: the deployed app itself
# never reads it (see src/lib/env.ts), and the production admin user is
# created once by hand in the Supabase dashboard instead (docs/deployment.md).
SUPABASE_SERVICE_ROLE_KEY=

# Secret — server-only (src/lib/payments/env.ts). Razorpay Payment Links:
# creating/cancelling a link (Key ID + Secret, Basic auth) and verifying the
# webhook's signature (Webhook Secret, HMAC-SHA256). Preview and Development
# environments use Test-mode keys; only Production uses Live keys — see
# CLAUDE.md's "External services" section. Get these from the Razorpay
# dashboard: Settings → API Keys (Key ID/Secret) and Settings → Webhooks
# (Webhook Secret, set when you register the webhook URL — see the README).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to "true" only for the Playwright E2E suite's own server process
# (never dev/production) -- short-circuits src/lib/payments/razorpay.ts
# with deterministic fake data instead of a real network call. Leave unset
# everywhere else.
RAZORPAY_MOCK=
