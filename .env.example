# Copy to .env.local for local development (values from `supabase start` output
# or `supabase status`). For deploying to Vercel, see docs/deployment.md for
# exactly which of these go into which Vercel environment (Production /
# Preview / Development) and where the values come from.

# Public — safe to expose to the browser. Required in every environment
# (Production, Preview, Development) that serves the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public — the app's own origin, no trailing slash (e.g.
# https://ekdesk.example.com). Only needed for Production: a payment
# request's WhatsApp/SMS message embeds an absolute pay-page link, and
# that's the one thing in this app that has to leave the browser as a full
# URL rather than a relative path. Preview falls back to Vercel's
# auto-injected VERCEL_URL, local dev to localhost -- see
# src/lib/site-url.ts.
NEXT_PUBLIC_SITE_URL=

# Secret — server-only, grants full bypass-RLS access. Never prefix it with
# NEXT_PUBLIC_. Two consumers:
# - The running app, via src/lib/supabase/admin.ts: Settings → Teachers
#   lists, creates, edits and deactivates teacher logins through the
#   Supabase Admin API, which needs this key. Every caller passes
#   requireRole("admin") first. So set it in Vercel for Production and
#   Preview -- without it the Teachers section renders but can't list or
#   create anyone (docs/deployment.md, step 5).
# - scripts/seed-auth-user.ts, to create the shared admin login against a
#   local or CI Supabase instance. The production admin user is still
#   created once by hand in the Supabase dashboard (docs/deployment.md).
SUPABASE_SERVICE_ROLE_KEY=
