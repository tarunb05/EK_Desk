# Copy to .env.local for local development (values from `supabase start` output
# or `supabase status`). For deploying to Vercel, see docs/deployment.md for
# exactly which of these go into which Vercel environment (Production /
# Preview / Development) and where the values come from.

# Public — safe to expose to the browser. Required in every environment
# (Production, Preview, Development) that serves the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only, grants full bypass-RLS access. Only ever used by
# scripts/seed-auth-user.ts to create the shared admin login against a local
# or CI Supabase instance. Never set this in Vercel: the deployed app itself
# never reads it (see src/lib/env.ts), and the production admin user is
# created once by hand in the Supabase dashboard instead (docs/deployment.md).
SUPABASE_SERVICE_ROLE_KEY=
